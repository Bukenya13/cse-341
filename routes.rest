### ------- Authentication -------
### POST, PUT, and DELETE below require a GitHub session. Open {{baseUrl}}/login
### in a browser and sign in first, or those requests return 401.

### Log in with GitHub (redirects to GitHub, then back to this app)
GET {{baseUrl}}/login

### Log out
GET {{baseUrl}}/logout

### ------- Public routes -------

### Show login status: "Logged in as <name>" or "Logged Out"
GET {{baseUrl}}/

### Same as the home route
GET {{baseUrl}}/whoami

### API index listing every collection and endpoint
GET {{baseUrl}}/api

### Swagger docs
GET {{baseUrl}}/api-docs/

### ------- Contacts -------

### Get all contacts
GET {{baseUrl}}/contacts

### Get one contact by id
GET {{baseUrl}}/contacts/{{contactId}}

### Create a new contact (requires login, all fields required)
POST {{baseUrl}}/contacts
Content-Type: application/json

{
  "firstName": "Frank",
  "lastName": "Fox",
  "email": "frank@example.com",
  "favoriteColor": "orange",
  "birthday": "1995-06-06"
}

### Update a contact by id
PUT {{baseUrl}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Alice",
  "lastName": "Anderson",
  "email": "alice.new@example.com",
  "favoriteColor": "teal",
  "birthday": "1990-01-01"
}

### Delete a contact by id
DELETE {{baseUrl}}/contacts/{{contactId}}

### ------- Users -------

### Get all users
GET {{baseUrl}}/users

### Get one user by id
GET {{baseUrl}}/users/{{userId}}

### Create a new user (requires login, all fields required)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "firstName": "Eve",
  "lastName": "Evans",
  "username": "eve.evans",
  "email": "eve@example.com",
  "phone": "+1-415-555-0199",
  "city": "Seattle",
  "ipaddress": "198.51.100.23"
}

### Update a user by id
PUT {{baseUrl}}/users/{{userId}}
Content-Type: application/json

{
  "firstName": "Eve",
  "lastName": "Evans",
  "username": "eve.evans",
  "email": "eve.updated@example.com",
  "phone": "+1-415-555-0199",
  "city": "Portland",
  "ipaddress": "198.51.100.24"
}

### Delete a user by id
DELETE {{baseUrl}}/users/{{userId}}

### ------- Colleges -------

### Get all colleges
GET {{baseUrl}}/colleges

### Get one college by id (includes its courses)
GET {{baseUrl}}/colleges/{{collegeId}}

### Create a new college (requires login, all fields required)
POST {{baseUrl}}/colleges
Content-Type: application/json

{
  "name": "Makerere University",
  "code": "MAK",
  "email": "admissions@mak.ac.ug",
  "phone": "+256-414-422-000",
  "city": "Kampala",
  "country": "Uganda",
  "establishedYear": 1922,
  "type": "public",
  "website": "https://www.mak.ac.ug"
}

### Update a college by id
PUT {{baseUrl}}/colleges/{{collegeId}}
Content-Type: application/json

{
  "name": "Makerere University",
  "code": "MAK",
  "email": "admissions.updated@mak.ac.ug",
  "phone": "+256-414-422-001",
  "city": "Kampala",
  "country": "Uganda",
  "establishedYear": 1922,
  "type": "public",
  "website": "https://www.mak.ac.ug"
}

### Delete a college by id (also deletes its courses)
DELETE {{baseUrl}}/colleges/{{collegeId}}

### ------- Courses -------

### Get all courses
GET {{baseUrl}}/courses

### Get one course by id
GET {{baseUrl}}/courses/{{courseId}}

### Create a new course (requires login, collegeId must be an existing college)
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "name": "Bachelor of Science in Computer Science",
  "code": "BSCS",
  "collegeId": "{{collegeId}}",
  "credits": 120,
  "duration": 4,
  "level": "bachelors",
  "faculty": "Faculty of Technology",
  "description": "Covers programming, algorithms, databases, and software engineering."
}

### Update a course by id
PUT {{baseUrl}}/courses/{{courseId}}
Content-Type: application/json

{
  "name": "Bachelor of Science in Computer Science",
  "code": "BSCS",
  "collegeId": "{{collegeId}}",
  "credits": 130,
  "duration": 4,
  "level": "bachelors",
  "faculty": "Faculty of Technology",
  "description": "Covers programming, algorithms, databases, and software engineering."
}

### Delete a course by id
DELETE {{baseUrl}}/courses/{{courseId}}

