@contactId = 6aa90a1fa794f666559fc83e
@userId = 656cc00e7b8f59f7e2b3a4b5

### Home route
GET {{baseUrl}}/

### Swagger docs
GET {{baseUrl}}/api-docs/

### ------- Contacts -------

### Get all contacts
GET {{baseUrl}}/contacts

### Get one contact by id
GET {{baseUrl}}/contacts/{{contactId}}

### Create a new contact (all fields required)
POST {{baseUrl}}/contacts
Content-Type: application/json

{
  "firstName": "Frank",
  "lastName": "Fox",
  "email": "frank@example.com",
  "favoriteColor": "orange",
  "birthday": "1995-06-06"
}

### Update a contact by id
PUT {{baseUrl}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Alice",
  "lastName": "Anderson",
  "email": "alice.new@example.com",
  "favoriteColor": "teal",
  "birthday": "1990-01-01"
}

### Delete a contact by id
DELETE {{baseUrl}}/contacts/{{contactId}}

### ------- Users -------

### Get all users
GET {{baseUrl}}/users

### Get one user by id
GET {{baseUrl}}/users/{{userId}}

### Create a new user (all fields required)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "firstName": "Eve",
  "lastName": "Evans",
  "username": "eve.evans",
  "email": "eve@example.com",
  "phone": "+1-415-555-0199",
  "city": "Seattle",
  "ipaddress": "198.51.100.23"
}

### Update a user by id
PUT {{baseUrl}}/users/{{userId}}
Content-Type: application/json

{
  "firstName": "Eve",
  "lastName": "Evans",
  "username": "eve.evans",
  "email": "eve.updated@example.com",
  "phone": "+1-415-555-0199",
  "city": "Portland",
  "ipaddress": "198.51.100.24"
}

### Delete a user by id
DELETE {{baseUrl}}/users/{{userId}}