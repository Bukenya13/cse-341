{
    "openapi": "3.0.0",
    "info": {
        "title": "CSE 341 Project 2 API",
        "description": "REST API performing full CRUD operations on the contacts and users collections in MongoDB. All routes include data validation and error handling, and return proper HTTP status codes. Every POST, PUT, and DELETE route requires an authenticated GitHub session and returns 401 otherwise. To try a protected route in Swagger UI, open /login in a browser and sign in with the same host, then reload this page.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://web-servises-cse-341.onrender.com/",
            "description": "Production (Render)"
        },
        {
            "url": "http://localhost:3000",
            "description": "Local development"
        }
    ],
    "tags": [
        {
            "name": "Contacts",
            "description": "Operations on the contacts collection"
        },
        {
            "name": "Users",
            "description": "Operations on the users collection"
        },
        {
            "name": "Authentication",
            "description": "GitHub OAuth login and logout"
        }
    ],
    "paths": {
        "/login": {
            "get": {
                "tags": ["Authentication"],
                "operationId": "githubLogin",
                "summary": "Log in with GitHub OAuth",
                "description": "Redirects the user to GitHub to authorize this application.",
                "responses": {
                    "302": {
                        "description": "Redirect to GitHub"
                    }
                }
            }
        },
        "/github/callback": {
            "get": {
                "tags": ["Authentication"],
                "operationId": "githubCallback",
                "summary": "GitHub OAuth callback",
                "description": "Receives the OAuth authorization code from GitHub and completes authentication.",
                "responses": {
                    "302": {
                        "description": "Redirect to the home page"
                    },
                    "401": {
                        "description": "Authentication failed"
                    }
                }
            }
        },
        "/logout": {
            "get": {
                "tags": ["Authentication"],
                "operationId": "logout",
                "summary": "Log out",
                "description": "Ends the current session and logs the user out.",
                "responses": {
                    "302": {
                        "description": "Redirect to the home page"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            }
        },
        "/contacts": {
            "get": {
                "tags": ["Contacts"],
                "operationId": "getContacts",
                "summary": "Get all contacts",
                "description": "Returns a list of every contact in the contacts collection.",
                "responses": {
                    "200": {
                        "description": "A list of contacts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Contact"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "post": {
                "tags": ["Contacts"],
                "operationId": "createContact",
                "security": [{ "githubOAuth": [] }],
                "summary": "Create a contact",
                "description": "Inserts a new contact into the contacts collection. All fields are required.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Contact"
                            },
                            "examples": {
                                "contact": {
                                    "value": {
                                        "firstName": "Alice",
                                        "lastName": "Anderson",
                                        "email": "alice@example.com",
                                        "favoriteColor": "blue",
                                        "birthday": "1990-01-01"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contact created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "example": "64f1e2d3a5b6c7d8e9f0a1b2"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing required fields or invalid data"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            }
        },
        "/contacts/{id}": {
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "The id of the contact",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "get": {
                "tags": ["Contacts"],
                "operationId": "getContactById",
                "summary": "Get a contact by id",
                "description": "Returns a single contact matching the given id.",
                "responses": {
                    "200": {
                        "description": "The requested contact",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Contact"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid contact id"
                    },
                    "404": {
                        "description": "Contact not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "put": {
                "tags": ["Contacts"],
                "operationId": "updateContact",
                "security": [{ "githubOAuth": [] }],
                "summary": "Update a contact by id",
                "description": "Replaces the fields of the contact matching the given id. All fields are required.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Contact"
                            },
                            "examples": {
                                "contact": {
                                    "value": {
                                        "firstName": "Alice",
                                        "lastName": "Anderson",
                                        "email": "alice.new@example.com",
                                        "favoriteColor": "teal",
                                        "birthday": "1990-01-01"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Contact updated"
                    },
                    "400": {
                        "description": "Invalid contact id or missing fields"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "404": {
                        "description": "Contact not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "delete": {
                "tags": ["Contacts"],
                "operationId": "deleteContact",
                "security": [{ "githubOAuth": [] }],
                "summary": "Delete a contact by id",
                "description": "Deletes the contact matching the given id.",
                "responses": {
                    "204": {
                        "description": "Contact deleted"
                    },
                    "400": {
                        "description": "Invalid contact id"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "404": {
                        "description": "Contact not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            }
        },
        "/users": {
            "get": {
                "tags": ["Users"],
                "operationId": "getUsers",
                "summary": "Get all users",
                "description": "Returns a list of every document in the users collection.",
                "responses": {
                    "200": {
                        "description": "A list of users",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/User"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "post": {
                "tags": ["Users"],
                "operationId": "createUser",
                "security": [{ "githubOAuth": [] }],
                "summary": "Create a user",
                "description": "Inserts a new user into the users collection. All fields are required.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            },
                            "examples": {
                                "user": {
                                    "value": {
                                        "firstName": "Alice",
                                        "lastName": "Anderson",
                                        "username": "alice.anderson",
                                        "email": "alice@example.com",
                                        "phone": "+1-202-555-0101",
                                        "city": "New York",
                                        "ipaddress": "192.168.1.101",
                                        "profilePicture": "https://avatars.tzador.com/face?id=44985295-3d9e-4ca6-b61a-322f86fa9499&size=128"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "example": "64f1e2d3a5b6c7d8e9f0a1b2"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing required fields or invalid data"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            }
        },
        "/users/{id}": {
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "The id of the user",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "get": {
                "tags": ["Users"],
                "operationId": "getUserById",
                "summary": "Get a user by id",
                "description": "Returns a single user matching the given id.",
                "responses": {
                    "200": {
                        "description": "The requested user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid user id"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "put": {
                "tags": ["Users"],
                "operationId": "updateUser",
                "security": [{ "githubOAuth": [] }],
                "summary": "Update a user by id",
                "description": "Replaces the fields of the user matching the given id. All fields are required.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            },
                            "examples": {
                                "user": {
                                    "value": {
                                        "firstName": "Alice",
                                        "lastName": "Anderson",
                                        "username": "alice.anderson",
                                        "email": "alice.new@example.com",
                                        "phone": "+1-202-555-0102",
                                        "city": "Brooklyn",
                                        "ipaddress": "192.168.1.102",
                                        "profilePicture": "https://avatars.tzador.com/face?id=9801f2c5-500e-40bd-99cf-3fd054e4d4d8&size=128"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "User updated"
                    },
                    "400": {
                        "description": "Invalid user id or missing fields"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            },
            "delete": {
                "tags": ["Users"],
                "operationId": "deleteUser",
                "security": [{ "githubOAuth": [] }],
                "summary": "Delete a user by id",
                "description": "Deletes the user matching the given id.",
                "responses": {
                    "204": {
                        "description": "User deleted"
                    },
                    "400": {
                        "description": "Invalid user id"
                    },
                    "401": {
                        "description": "Not authenticated; log in with GitHub first"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "An unexpected error occurred"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "githubOAuth": {
                "type": "oauth2",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "https://github.com/login/oauth/authorize",
                        "tokenUrl": "https://github.com/login/oauth/access_token",
                        "scopes": {
                            "user:email": "Read access to your email address"
                        }
                    }
                }
            }
        },
        "schemas": {
            "Contact": {
                "type": "object",
                "required": ["firstName", "lastName", "email", "favoriteColor", "birthday"],
                "properties": {
                    "firstName": {
                        "type": "string",
                        "example": "Alice"
                    },
                    "lastName": {
                        "type": "string",
                        "example": "Anderson"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "alice@example.com"
                    },
                    "favoriteColor": {
                        "type": "string",
                        "example": "blue"
                    },
                    "birthday": {
                        "type": "string",
                        "example": "1990-01-01"
                    }
                }
            },
            "User": {
                "type": "object",
                "required": ["firstName", "lastName", "username", "email", "phone", "city", "ipaddress"],
                "properties": {
                    "firstName": {
                        "type": "string",
                        "example": "Alice"
                    },
                    "lastName": {
                        "type": "string",
                        "example": "Anderson"
                    },
                    "username": {
                        "type": "string",
                        "example": "alice.anderson"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "alice@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "+1-202-555-0101"
                    },
                    "city": {
                        "type": "string",
                        "example": "New York"
                    },
                    "ipaddress": {
                        "type": "string",
                        "example": "192.168.1.101"
                    },
                    "profilePicture": {
                        "type": "string",
                        "format": "uri",
                        "description": "URL to the user's profile picture (an African portrait, auto-assigned on create if omitted).",
                        "example": "https://avatars.tzador.com/face?id=44985295-3d9e-4ca6-b61a-322f86fa9499&size=128"
                    }
                }
            }
        }
    }
}